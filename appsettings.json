{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/logmanager-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AppConfiguration": {
    "PassPattern": "^PASS_",
    "FailPattern": "^FAIL_",
    "Sftp": {
      "Host": "127.0.0.1",
      "Port": 22,
      "Username": "user",
      "Password": "password",
      "RemoteLogPath": "/logs"
    }
  }
}